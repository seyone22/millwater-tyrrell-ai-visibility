            },
            {
              "segment": {
                "startIndex": 3762,
                "endIndex": 3928,
                "text": "Most boutique firms offer a **15–20 minute complimentary telephone triage** to check for conflicts of interest, review your circumstances, and provide a fixed quote"
              },
              "groundingChunkIndices": [
