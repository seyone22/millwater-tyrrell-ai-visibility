            },
            {
              "segment": {
                "startIndex": 2886,
                "endIndex": 3068,
                "text": "Under Queensland law (*Succession Act 1981*), an executor must receive **written notice of an intention to bring a Family Provision Application within 6 months** of the date of death"
              },
              "groundingChunkIndices": [
                1,
                11
              ]
            },
            {
              "segment": {
                "startIndex": 3075,
                "endIndex": 3173,
                "text": "The formal originating application must be **filed in court within 9 months** of the date of death"
              },
              "groundingChunkIndices": [
                1
              ]
            },
            {
              "segment": {
                "startIndex": 3204,
                "endIndex": 3419,
                "text": "Many estate litigation firms take strong FPA or contested will matters on a **\"No Win, No Fee\"** or **deferred payment** basis (where legal fees are paid out of the final settlement or court-awarded estate proceeds)"
              },
              "groundingChunkIndices": [
                12,
                13
              ]
            },
            {
              "segment": {
                "startIndex": 3421,
                "endIndex": 3496,
                "text": "Ask upfront during your initial consultation what billing models they offer"
