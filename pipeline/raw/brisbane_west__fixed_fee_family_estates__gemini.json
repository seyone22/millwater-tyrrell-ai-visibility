            },
            {
              "segment": {
                "startIndex": 1360,
                "endIndex": 1419,
                "text": "**Location:** Mount Ommaney Shopping Centre, Dandenong Road"
              },
              "groundingChunkIndices": [
                4
              ]
            },
            {
              "segment": {
                "startIndex": 1427,
                "endIndex": 1494,
                "text": "**Practice Areas:** Family law, estate planning, wills, and probate"
              },
              "groundingChunkIndices": [
                5
              ]
            },
            {
              "segment": {
                "startIndex": 1502,
                "endIndex": 1671,
                "text": "**Fee Options:** A boutique practice handling local Centenary matters, offering transparent fee structuring and fixed quotes for wills and estate administration packages"
              },
              "groundingChunkIndices": [
                5,
                6
              ]
            },
            {
              "segment": {
                "startIndex": 1726,
                "endIndex": 1804,
                "text": "**Location:** Indooroopilly (near Indooroopilly Shopping Centre/Train Station)"
              },
              "groundingChunkIndices": [
