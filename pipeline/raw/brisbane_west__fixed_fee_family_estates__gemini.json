            },
            {
              "segment": {
                "startIndex": 1812,
                "endIndex": 1901,
                "text": "**Practice Areas:** Exclusively family law (divorce, parenting, and property settlements)"
              },
              "groundingChunkIndices": [
                7
              ]
            },
            {
              "segment": {
                "startIndex": 2078,
